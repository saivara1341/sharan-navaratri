# Cloudflare Pages Caching & Security Headers

# Immutable long-term caching for Vite hashed assets (JS/CSS)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Long-term caching for static images, icons, and media
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Fonts cache for 1 year
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Root and HTML pages: Always revalidate for instant updates
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
