{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/sharan-navaratri/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/sharan-navaratri/navaratri/assets/:match*",
      "destination": "/navaratri/assets/:match*"
    },
    {
      "source": "/sharan-navaratri/:match*",
      "destination": "/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
